# Cloudflare Workers へのデプロイに使用するシークレット
# `wrangler deploy` や CI からのデプロイに必要な認証情報。
# ローカル開発では `.dev.vars` (git管理外) に、CI では GitHub Actions の Secrets に設定する。

# Cloudflare アカウントID (Cloudflareダッシュボードの右サイドバーで確認できる)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare APIトークン (Workers の編集権限を持つトークンを発行する)
CLOUDFLARE_API_TOKEN=
